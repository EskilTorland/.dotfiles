{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "edit": "ask",
        "bash": {
            "*": "ask",
            "git *": "allow",
            "npm *": "allow",
            "grep *": "allow",
            "ls *": "allow",
            "cat *": "allow",
            "echo *": "allow",
            "cd *": "allow",
            "find *": "allow",
            "gh *": "allow"
        }
    },
    "mcp": {
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true,
            "headers": {
                "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
            }
        },
        "grep": {
            "type": "remote",
            "url": "https://mcp.grep.app"
        },
        "figma": {
            "type": "remote",
            "url": "https://mcp.figma.com/mcp"
        },
        "playwright": {
            "type": "local",
            "command": [
                "/Users/eskil/.config/opencode/node_modules/.bin/playwright-mcp"
            ],
            "enabled": true
        },
        "azure": {
            "type": "local",
            "command": [
                "/Users/eskil/.config/opencode/node_modules/@azure/mcp/index.js",
                "server",
                "start"
            ],
            "enabled": true
        },
        "atlassian": {
            "type": "remote",
            "url": "https://mcp.atlassian.com/v1/mcp"
        },
        "github": {
            "enabled": true,
            "type": "remote",
            "url": "https://api.githubcopilot.com/mcp/",
            "headers": {
                "Authorization": "Bearer {env:GITHUB_TOKEN}"
            }
        }
    },
    "instructions": [
        "/Users/eskil/.config/opencode/rules/*.md"
    ],
    "plugin": [
        "oh-my-openagent"
    ]
}
